{
    "name": "omidgfx/open-responder",
    "version": "1.0.0",
    "description": "A self-contained Laravel API response builder with transformer support (no external packages, Fractal engine inlined).",
    "keywords": [
        "laravel",
        "fractal",
        "transformer",
        "api",
        "response",
        "responder"
    ],
    "homepage": "https://github.com/omidgfx/open-responder",
    "license": "MIT",
    "authors": [
        {
            "name": "Pejman Chatrrouz",
            "email": "omid.quist@gmail.com"
        }
    ],
    "require": {
        "php": "^7.4|^8.0",
        "illuminate/contracts": "^7.0|^8.0|^9.0|^10.0|^11.0|^12.0|^13.0",
        "illuminate/support": "^7.0|^8.0|^9.0|^10.0|^11.0|^12.0|^13.0"
    },
    "autoload": {
        "psr-4": {
            "Omidgfx\\Responder\\": "src"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "config": {
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "providers": [
                "Omidgfx\\Responder\\ResponderServiceProvider"
            ],
            "aliases": {
                "Responder": "Omidgfx\\Responder\\Facades\\Responder",
                "Transformer": "Omidgfx\\Responder\\Facades\\Transformation"
            }
        }
    }
}
